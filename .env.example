# ─────────────────────────────────────────
# Trip Planner — required env vars
# ─────────────────────────────────────────
# Copy this file to .env.local for local dev,
# and set the same vars in Vercel project settings for production.

# Site URL (used in checkout redirects + email links)
NEXT_PUBLIC_SITE_URL=https://checkvisamap.com

# ─── Anthropic (Claude) ───
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ─── Supabase ───
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxx
# Public client (browser) — required for magic-link auth, /account, /login.
# Same project URL as above; the anon key is a separate (safe-to-expose) key
# from the Supabase dashboard. WITHOUT THESE, AUTH BREAKS IN PRODUCTION.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxx

# ─── Lemon Squeezy ───
# https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=eyJxxxxxxxxxxxxxxxxxxxx
LEMON_SQUEEZY_STORE_ID=12345
LEMON_SQUEEZY_VARIANT_ID=67890
# Webhook secret — set when creating the webhook in LS dashboard:
# https://app.lemonsqueezy.com/settings/webhooks
LEMON_SQUEEZY_WEBHOOK_SECRET=your-shared-secret-here

# ─── Mapbox ───
# https://account.mapbox.com/access-tokens/
# The PUBLIC token is exposed in the browser (rotate if abused).
# The server token can be the same — Mapbox tokens are URL-restricted by default.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxx
MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxx

# ─── Resend (email) ───
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Your verified sender — must match a domain you own and verified in Resend
RESEND_FROM_EMAIL="gliddy <plans@checkvisamap.com>"
