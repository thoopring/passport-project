# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# but the template (no real secrets) should be checked in
!.env.example

# vercel
.vercel

# supabase CLI local cache
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
public/sample/
public/vs.png
public/layla.png
public/cc.png
public/[0-9].png
public/[0-9][0-9].png

# User-shared sample PDFs for diagnostics — not production artifacts
docs/*.pdf
app/*.pdf
